<?xml version='1.0' encoding='utf-8'?>
<!--
  MAX-MAT-009 color-space round-trip surgical-coverage fixture.

  Carries a standard_surface whose base_color carries an INTENTIONAL
  colorspace="srgb_texture" attribute. After import via
  MaterialXMaterial.importMaterial and export through USDExporter, the
  resulting USD shader's `inputs:base_color` attribute MUST carry
  `colorSpace = "srgb_texture"` USD metadata -- and `inputs:base`,
  `inputs:specular_roughness`, `inputs:specular_IOR` (all float-typed)
  MUST NOT carry any colorSpace metadata even though the input element
  ALSO carries the same colorspace attribute (the C++
  `_TypeSupportsColorSpace` predicate rejects float-typed inputs).

  The test pins the surgical bound the MtlxShaderWriter audit
  documents (MAX-MAT-009): which input types may propagate
  `colorSpace` USD metadata, and which short-circuit before
  authoring it.

  All inputs other than base_color and the three float-typed negative
  cases are at MaterialX standard_surface nodedef defaults so the
  parallel MAX-MAT-001/002/004/005/006 normalization passes leave the
  fixture alone.
-->
<materialx version="1.38">
  <standard_surface name="SR_IntentionalColorSpace" type="surfaceshader">
    <input name="base" type="float" value="0.8" colorspace="srgb_texture" />
    <input name="base_color" type="color3" value=" 0.500000, 0.500000, 0.500000" colorspace="srgb_texture" />
    <input name="diffuse_roughness" type="float" value="0.0" />
    <input name="metalness" type="float" value="0.0" />
    <input name="specular" type="float" value="1.0" />
    <input name="specular_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="specular_roughness" type="float" value="0.2" colorspace="srgb_texture" />
    <input name="specular_IOR" type="float" value="1.5" colorspace="srgb_texture" />
    <input name="specular_anisotropy" type="float" value="0.0" />
    <input name="specular_rotation" type="float" value="0.0" />
    <input name="transmission" type="float" value="0.0" />
    <input name="transmission_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="transmission_depth" type="float" value="0.0" />
    <input name="subsurface" type="float" value="0.0" />
    <input name="subsurface_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="subsurface_radius" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="subsurface_scale" type="float" value="1.0" />
    <input name="sheen" type="float" value="0.0" />
    <input name="sheen_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="sheen_roughness" type="float" value="0.3" />
    <input name="coat" type="float" value="0.0" />
    <input name="coat_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="coat_roughness" type="float" value="0.1" />
    <input name="coat_IOR" type="float" value="1.5" />
    <input name="coat_affect_color" type="float" value="0.0" />
    <input name="coat_affect_roughness" type="float" value="0.0" />
    <input name="emission" type="float" value="0.0" />
    <input name="emission_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="opacity" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="thin_walled" type="boolean" value="false" />
  </standard_surface>
  <surfacematerial name="IntentionalColorSpace" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_IntentionalColorSpace" />
  </surfacematerial>
</materialx>
