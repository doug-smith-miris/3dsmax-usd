<?xml version='1.0' encoding='utf-8'?>
<!--
  MAX-MAT-006 surgical-preservation fixture.

  Carries each of the 13 MAX-MAT-006 in-scope inputs at a value that
  DIFFERS from the ND_standard_surface_surfaceshader v1.0.1 nodedef default.
  The spec-default normalizer's gate is "value == nodedef default", so it
  MUST leave every one of these intentional values untouched. The
  regression test asserts that surgical bound input-by-input.

  Inputs not in MAX-MAT-006's scope (specular_rotation, emission*, coat_*
  IOR/affect_color/affect_roughness/roughness, subsurface_radius) are
  carried at their nodedef defaults so the parallel MAX-MAT-001/002/004/005
  normalizers either no-op or strip them cleanly without affecting this
  test's assertions.
-->
<materialx version="1.38">
  <standard_surface name="SR_IntentionalSpec" type="surfaceshader">
    <input name="base" type="float" value="0.6" />
    <input name="base_color" type="color3" value=" 0.500000, 0.500000, 0.500000" />
    <input name="diffuse_roughness" type="float" value="0.3" />
    <input name="metalness" type="float" value="0.0" />
    <input name="specular" type="float" value="0.7" />
    <input name="specular_color" type="color3" value=" 0.800000, 0.800000, 0.900000" />
    <input name="specular_roughness" type="float" value="0.2" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0.0" />
    <input name="specular_rotation" type="float" value="0.0" />
    <input name="transmission" type="float" value="0.5" />
    <input name="transmission_color" type="color3" value=" 0.300000, 0.600000, 0.900000" />
    <input name="transmission_depth" type="float" value="1.5" />
    <input name="subsurface" type="float" value="0.2" />
    <input name="subsurface_color" type="color3" value=" 0.700000, 0.500000, 0.500000" />
    <input name="subsurface_radius" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="subsurface_scale" type="float" value="2.0" />
    <input name="sheen" type="float" value="0.0" />
    <input name="sheen_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="sheen_roughness" type="float" value="0.3" />
    <input name="coat" type="float" value="0.4" />
    <input name="coat_color" type="color3" value=" 0.900000, 0.400000, 0.100000" />
    <input name="coat_roughness" type="float" value="0.1" />
    <input name="coat_IOR" type="float" value="1.5" />
    <input name="coat_affect_color" type="float" value="0.0" />
    <input name="coat_affect_roughness" type="float" value="0.0" />
    <input name="emission" type="float" value="0.0" />
    <input name="emission_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="opacity" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="thin_walled" type="boolean" value="true" />
  </standard_surface>
  <surfacematerial name="IntentionalSpec" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_IntentionalSpec" />
  </surfacematerial>
</materialx>
