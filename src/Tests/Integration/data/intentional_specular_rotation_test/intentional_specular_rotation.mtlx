<?xml version='1.0' encoding='utf-8'?>
<!--
  MAX-MAT-001 surgical-preservation fixture.

  Carries INTENTIONAL anisotropic specular rotation -- a brushed-steel-
  like configuration where the rotation IS observable in the BSDF:

      specular_rotation   = 0.25   (the value that coincides with the leak)
      specular_anisotropy = 0.85   (strongly anisotropic -- rotation matters)
      specular_roughness  = 0.18   (sharp highlight -- direction visible)

  The rotation value 0.25 matches the bridge's hard-coded leak byte-for-
  byte, but because specular_anisotropy is statically non-zero the
  post-parse normalizer in MtlxShaderWriter::Write MUST leave the
  rotation untouched -- the rotation has a real BSDF effect (90-degree
  turn of the anisotropic streak) and stripping it would silently rewrite
  the artist's authored brushed-steel look into a perpendicular,
  un-rotated streak.

  All other inputs are at MaterialX standard_surface nodedef defaults so
  the test focuses on the rotation surgical bound and is robust to the
  parallel MAX-MAT-002 / MAX-MAT-004 / MAX-MAT-005 / MAX-MAT-006
  normalization passes (none of which match).
-->
<materialx version="1.38">
  <standard_surface name="SR_IntentionalSpecularRotation" type="surfaceshader">
    <input name="base" type="float" value="0.8" />
    <input name="base_color" type="color3" value=" 0.500000, 0.500000, 0.550000" />
    <input name="diffuse_roughness" type="float" value="0.0" />
    <input name="metalness" type="float" value="0.0" />
    <input name="specular" type="float" value="1.0" />
    <input name="specular_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="specular_roughness" type="float" value="0.18" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_anisotropy" type="float" value="0.85" />
    <input name="specular_rotation" type="float" value="0.25" />
    <input name="transmission" type="float" value="0.0" />
    <input name="transmission_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="transmission_depth" type="float" value="0.0" />
    <input name="subsurface" type="float" value="0.0" />
    <input name="subsurface_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="subsurface_radius" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="subsurface_scale" type="float" value="1.0" />
    <input name="sheen" type="float" value="0.0" />
    <input name="sheen_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="sheen_roughness" type="float" value="0.3" />
    <input name="coat" type="float" value="0.0" />
    <input name="coat_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="coat_roughness" type="float" value="0.1" />
    <input name="coat_IOR" type="float" value="1.5" />
    <input name="coat_affect_color" type="float" value="0.0" />
    <input name="coat_affect_roughness" type="float" value="0.0" />
    <input name="emission" type="float" value="0.0" />
    <input name="emission_color" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="opacity" type="color3" value=" 1.000000, 1.000000, 1.000000" />
    <input name="thin_walled" type="boolean" value="false" />
  </standard_surface>
  <surfacematerial name="IntentionalSpecularRotation" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_IntentionalSpecularRotation" />
  </surfacematerial>
</materialx>
